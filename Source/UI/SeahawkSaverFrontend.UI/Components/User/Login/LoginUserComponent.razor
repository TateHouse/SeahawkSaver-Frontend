@using SeahawkSaverFrontend.UI.Components.Utilities
<MudContainer Class="mx-auto pa-6"
              MaxWidth="MaxWidth.Medium">
    <SectionHeaderComponent Align="Align.Center"
                            Style="font-size: 1.5em;"
                            Typo="Typo.body1">
        Please log in to access your financial dashboard, where you can track your financial health to stay on
        top of your financial goals.
    </SectionHeaderComponent>
    <MudCard Class="my-4"
             Elevation="2">
        <MudCardContent>
            <MudText Align="Align.Center"
                     Class="mb-10"
                     Style="font-weight: bold;"
                     Typo="Typo.h2">
                Login
            </MudText>
            <LoginUserFormComponent/>
        </MudCardContent>
    </MudCard>
</MudContainer>