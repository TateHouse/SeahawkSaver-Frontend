<MudContainer Class="mx-auto pa-6"
              MaxWidth="MaxWidth.Medium">
    <MudCard Class="my-4 pa-8 mud-theme-secondary"
             Elevation="2">
        <MudCardContent>
            <MudText Align="Align.Center">
                Please log in to access your financial dashboard, where you can track your financial health to stay on
                top of your financial goals.
            </MudText>
        </MudCardContent>
    </MudCard>
    <MudCard>
        <MudPaper Elevation="2">
            <MudDivider Class="pa-2 mud-theme-tertiary"/>
        </MudPaper>
    </MudCard>
    <MudCard Class="my-4"
             Elevation="2">
        <MudCardContent>
            <MudText Align="Align.Center"
                     Class="mb-10"
                     Style="font-weight: bold;"
                     Typo="Typo.h2">
                Login
            </MudText>
            <LoginUserFormComponent/>
        </MudCardContent>
    </MudCard>
</MudContainer>