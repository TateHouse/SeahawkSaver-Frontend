@page "/profile"
@using SeahawkSaverFrontend.Application.Abstractions.Caching
@using SeahawkSaverFrontend.UI.Components.Utilities
@inject NavigationManager NavigationManager
@inject IAuthenticationCache AuthenticationCache

<PageTitle>Seahawk Saver | Profile</PageTitle>

@if (!AuthenticationCache.IsAuthenticated())
{
    NavigationManager.NavigateTo("/login");
}
else
{
    <MudContainer Class="pa-6"
                  Gutters="false"
                  MaxWidth="MaxWidth.Medium">
        <SectionHeaderComponent Align="Align.Center"
                                Typo="Typo.h2">
            User Profile
        </SectionHeaderComponent>
        <MudCard Class="my-4"
                 Elevation="2">
            <MudCardContent>
                <ManageUserModelFormComponent/>
            </MudCardContent>
        </MudCard>
    </MudContainer>
}