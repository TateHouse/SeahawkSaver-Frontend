@using SeahawkSaverFrontend.Application.Abstractions.Caching
@using SeahawkSaverFrontend.Application.Abstractions.UseCases
@using SeahawkSaverFrontend.Domain.Models.Financial
@inject ISnackbar Snackbar
@inject IUseCaseFactory UseCaseFactory
@inject IFinancialModelCache<IncomeModel> IncomeModelCache

<MudNumericField Adornment="Adornment.Start"
                 AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                 @bind-Value="incomeModel.Amount"
                 Error="@propertyValidationStatuses[nameof(IncomeModel.Amount)]"
                 Label="Amount"
                 T="decimal"
                 Variant="Variant.Outlined"/>