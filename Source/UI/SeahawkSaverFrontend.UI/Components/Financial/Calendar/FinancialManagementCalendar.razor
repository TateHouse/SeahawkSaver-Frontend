@using SeahawkSaverFrontend.Application.Features.Caching.Financial
@inject FinancialManagementCalendarItemManager FinancialManagementCalendarItemManager
@inject InMemoryFinancialModelCacheManager FinancialModelCacheManager

<MudPaper Class="pa-10"
          Elevation="4"
          Style="height: 100%;">
    <MudTotalCalendar @ref="calendar"
                      CellClicked="OnCellClicked"
                      DateRangeChanged="OnDateRangeChanged"
                      ItemClicked="OnItemClicked"
                      Items="FinancialManagementCalendarItemManager.CalendarItems"
                      ShowDay="false"
                      ShowDayTotal="false"
                      ShowWeek="false"
                      ShowWeekTotal="@totalCalculationVisibilityToggles['W']"
                      ShowWorkWeek="false"
                      ShowMonth="true"
                      ShowMonthTotal="@totalCalculationVisibilityToggles['M']"
                      Style="height: 100%;"
                      Values="CalculateTotals()">
        <ToolbarContent>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled">
                Download Data
            </MudButton>
            <MudSwitch @bind-Value="totalCalculationVisibilityToggles['W']"
                       Class="mx-2"
                       Color="Color.Tertiary"
                       UncheckedColor="Color.Secondary"
                       T="bool">
                Weekly Totals
            </MudSwitch>
            <MudSwitch @bind-Value="totalCalculationVisibilityToggles['M']"
                       Class="mx-2"
                       Color="Color.Tertiary"
                       UncheckedColor="Color.Secondary"
                       T="bool">
                Monthly Total
            </MudSwitch>
        </ToolbarContent>
    </MudTotalCalendar>
</MudPaper>