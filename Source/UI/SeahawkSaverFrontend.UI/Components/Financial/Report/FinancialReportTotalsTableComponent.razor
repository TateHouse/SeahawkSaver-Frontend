@inject FinancialReportManager FinancialReportManager

<MudTable Items="@FinancialModelTotals">
    <HeaderContent>
        <MudTh Class="mud-theme-secondary">
            Type
        </MudTh>
        <MudTh Class="mud-theme-secondary">
            Count
        </MudTh>
        <MudTh Class="mud-theme-secondary">
            Total Amount
        </MudTh>
        <MudTh Class="mud-theme-secondary">
            Smallest Amount
        </MudTh>
        <MudTh Class="mud-theme-secondary">
            Largest Amount
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Type">
            @context.Type
        </MudTd>
        <MudTd DataLabel="Count">
            @context.Count
        </MudTd>
        <MudTd DataLabel="Total Amount">
            $@context.Amount
        </MudTd>
        <MudTd DataLabel="Smallest Amount">
            @context.SmallestAmount
        </MudTd>
        <MudTd DataLabel="Largest Amount">
            @context.LargestAmount
        </MudTd>
    </RowTemplate>
</MudTable>