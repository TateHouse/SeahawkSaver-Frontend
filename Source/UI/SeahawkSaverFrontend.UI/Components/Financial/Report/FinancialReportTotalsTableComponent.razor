@inject FinancialReportManager FinancialReportManager

<MudTable Items="@FinancialModelTotals">
    <HeaderContent>
        <MudTh Class="mud-theme-secondary">
            Type
        </MudTh>
        <MudTh Class="mud-theme-secondary">
            Count
        </MudTh>
        <MudTh Class="mud-theme-secondary">
            Total
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Type">
            @context.Type
        </MudTd>
        <MudTd DataLabel="Count">
            @context.Count
        </MudTd>
        <MudTd DataLabel="Total">
            $@context.Amount
        </MudTd>
    </RowTemplate>
</MudTable>