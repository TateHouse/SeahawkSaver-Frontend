@page "/financial-report"
@using SeahawkSaverFrontend.Application.Abstractions.Caching
@using SeahawkSaverFrontend.UI.Components.Utilities
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IAuthenticationCache AuthenticationCache
@inject FinancialReportManager FinancialReportManager

<PageTitle>Seahawk Saver | Financial Report</PageTitle>

@if (!AuthenticationCache.IsAuthenticated())
{
    NavigationManager.NavigateTo("/login");
}
else
{
    <MudContainer Class="pa-6"
                  Gutters="false"
                  MaxWidth="MaxWidth.Medium">
        <MudPaper Class="pa-10"
                  Elevation="4">
            <SectionHeaderComponent Typo="Typo.h3">
                Financial Report
            </SectionHeaderComponent>

            <MudCard Class="my-4"
                     Elevation="0"
                     Outlined="false">
                <MudCardContent Class="pa-0">
                    <FinancialReportTotalsTableComponent FinancialModelTotals="@FinancialReportManager.FinancialModelOverallTotals"/>
                </MudCardContent>
            </MudCard>
            <MudCard Class="my-4"
                     Elevation="0"
                     Outlined="false">
                <MudCardContent Class="pa-0">
                    <MudText Typo="Typo.h4">
                        Overall Totals
                    </MudText>
                    <FinancialReportTotalsPieChartComponent/>
                </MudCardContent>
            </MudCard>
            <MudCard Class="my-4"
                     Elevation="0"
                     Outlined="false">
                <MudCardContent Class="pa-0">
                    <MudText>
                        Net Savings: @FinancialReportManager.NetSavings.Amount.ToString("C")
                    </MudText>
                    <MudText>
                        Savings Rate: @FinancialReportManager.NetSavings.Percentage.ToString("P")
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @GetCurrentYear() Average Monthly Totals
                    </MudText>
                    <MudText>
                        Average Debt: @FinancialReportManager.AverageFinancialModelsPerMonth.AverageDebtAmount.ToString("C")
                    </MudText>
                    <MudText>
                        Average Expense: @FinancialReportManager.AverageFinancialModelsPerMonth.AverageExpenseAmount.ToString("C")
                    </MudText>
                    <MudText>
                        Average Income: @FinancialReportManager.AverageFinancialModelsPerMonth.AverageIncomeAmount.ToString("C")
                    </MudText>
                    <MudText>
                        Average Saving: @FinancialReportManager.AverageFinancialModelsPerMonth.AverageSavingAmount.ToString("C")
                    </MudText>
                    <MudText>
                        Average Subscription: @FinancialReportManager.AverageFinancialModelsPerMonth.AverageSubscriptionAmount.ToString("C")
                    </MudText>
                </MudCardContent>
            </MudCard>
            <MudCard Class="my-4"
                     Elevation="0"
                     Outlined="false">
                <MudCardContent Class="pa-0">
                    <MudText Typo="Typo.h4">
                        @GetCurrentYear() Monthly Totals
                    </MudText>
                    <FinancialReportCurrentYearMonthTotalsLineChartComponent/>
                </MudCardContent>
            </MudCard>
        </MudPaper>
    </MudContainer>
}