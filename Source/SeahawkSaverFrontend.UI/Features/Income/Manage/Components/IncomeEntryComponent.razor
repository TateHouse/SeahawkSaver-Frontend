<MudPaper>
    <MudForm>
        <MudTextField T="decimal"
                      @bind-Value="Model.Amount"
                      Label="Amount"
                      Disabled="!Model.IsEditable"/>
        <MudDatePicker @bind-Date="Model.DateTime"
                       Label="Basic example"
                       Disabled="!Model.IsEditable"/>
        <MudButton OnClick="@(() => ToggleEdit())">
            @(Model.IsEditable ? "Save" : "Edit")
        </MudButton>
        <MudButton OnClick="@(() => Delete())">
            Remove
        </MudButton>
    </MudForm>
    <MudText Class="mt-2"
             Typo="Typo.body1"
             Align="Align.Center"
             Color="Color.Error">
        @Model.ErrorMessage
    </MudText>
</MudPaper>