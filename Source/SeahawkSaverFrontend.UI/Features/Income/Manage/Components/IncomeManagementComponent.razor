@using SeahawkSaverFrontend.UI.Features.Income.Services
@inject IDialogService DialogService
@inject IIncomeService IncomeService

<MudContainer MaxWidth="MaxWidth.Small"
              Style="margin: auto; overflow-y: auto">
    <MudText Typo="Typo.h1"
             Align="Align.Center"
             Color="Color.Secondary"
             Style="font-weight: bold;">
        Incomes
    </MudText>
    <MudGrid Justify="Justify.Center">
        <MudItem>
            <MudButton Class="mud-theme-primary"
                       OnClick="Add">
                Add Income
            </MudButton>
        </MudItem>
    </MudGrid>
    <MudContainer MaxWidth="MaxWidth.Small">
        @foreach (var income in incomes)
        {
            <IncomeEntryComponent Model="income"
                                  OnSave="Save"
                                  OnDelete="Delete"/>
        }
    </MudContainer>
</MudContainer>