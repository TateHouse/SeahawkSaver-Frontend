@using SeahawkSaverFrontend.UI.Features.Income.Services
@inject IIncomeService IncomeService

<MudContainer MaxWidth="MaxWidth.Small"
              Style="margin: auto; max-height: 50vh ; overflow-y: auto">
    <MudText Typo="Typo.h1"
             Align="Align.Center"
             Color="Color.Secondary"
             Style="font-weight: bold;">
        Incomes
    </MudText>
    <MudContainer MaxWidth="MaxWidth.Small">
        @foreach (var income in incomes)
        {
            <IncomeEntryComponent Model="income"
                                  OnSave="Save"
                                  OnDelete="Delete"/>
        }
    </MudContainer>
</MudContainer>