@using SeahawkSaverFrontend.UI.Features.Caching.Services
@inject IDataCache DataCache

<MudPaper>
    <MudForm>
        <MudTextField T="string"
                      @bind-Value="Model.Email"
                      Label="Email"
                      Disabled="!Model.IsEditable"/>
        <MudTextField T="string"
                      @bind-Value="Model.FirstName"
                      Label="First Name"
                      Disabled="!Model.IsEditable"/>
        <MudTextField T="string"
                      @bind-Value="Model.LastName"
                      Label="Last Name"
                      Disabled="!Model.IsEditable"/>
        @if (DataCache.User.IsAdmin)
        {
            <MudCheckBox @bind-Value="Model.IsActive"
                         Label="Is Active"
                         Color="Color.Tertiary"
                         UncheckedColor="Color.Secondary"
                         Disabled="!Model.IsEditable">
            </MudCheckBox>
        }

        <MudButton OnClick="@(() => ToggleEdit())">
            @(Model.IsEditable ? "Save" : "Edit")
        </MudButton>
    </MudForm>
    <MudText Class="mt-2"
             Typo="Typo.body1"
             Align="Align.Center"
             Color="Color.Error">
        @Model.ErrorMessage
    </MudText>
</MudPaper>