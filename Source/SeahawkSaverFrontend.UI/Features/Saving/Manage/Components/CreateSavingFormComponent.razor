@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        Create Saving
    </TitleContent>
    <DialogContent>
        <MudTextField T="decimal"
                      Required="true"
                      @bind-Value="model.Amount"
                      Error="@isAmountValid"
                      HelperText="@amountErrorMessage"
                      Label="Amount"/>
        <MudDatePicker @bind-Date="model.DateTime"
                       Required="true"
                       Error="@isDateValid"
                       HelperText="@dateErrorMessage"
                       Label="Date"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit">
            Create
        </MudButton>
        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>
