@using SeahawkSaverFrontend.UI.Features.Saving.Services
@inject IDialogService DialogService
@inject ISavingService SavingService

<MudContainer MaxWidth="MaxWidth.Small"
              Style="margin: auto; overflow-y: auto">
    <MudText Typo="Typo.h1"
             Align="Align.Center"
             Color="Color.Secondary"
             Style="font-weight: bold;">
        Saving Management
    </MudText>
    <MudGrid Justify="Justify.Center">
        <MudItem>
            <MudButton Class="mud-theme-primary"
                       OnClick="Add">
                Add Saving
            </MudButton>
        </MudItem>
    </MudGrid>
    <MudContainer MaxWidth="MaxWidth.Small">
        @foreach (var saving in savings)
        {
            <SavingEntryComponent Model="saving"
                                  OnSave="Save"
                                  OnDelete="Delete"/>
        }
    </MudContainer>
</MudContainer>
