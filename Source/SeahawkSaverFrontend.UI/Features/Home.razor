@page "/"
@using SeahawkSaverFrontend.UI.Features.Caching.Services
@using SeahawkSaverFrontend.UI.Features.Income.Manage.Components
@using SeahawkSaverFrontend.UI.Features.User.Manage.Components

@inject NavigationManager NavigationManager
@inject IDataCache DataCache

<PageTitle>Seahawk Saver | Home</PageTitle>

@if (string.IsNullOrWhiteSpace(DataCache.Token))
{
    NavigationManager.NavigateTo("/login");
}
else
{
    <div style="display: flex; justify-content: space-between; gap: 16px;">
        <MudCard Style="flex: 1">
            <MudCardContent>
                <UserManagementComponent/>
            </MudCardContent>
        </MudCard>

        @if (DataCache.User.IsAdmin == false)
        {
            <MudCard Style="flex: 1">
                <MudCardContent>
                    <IncomeManagementComponent/>
                </MudCardContent>
            </MudCard>
        }
    </div>
}