@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        Manage
    </TitleContent>
    <DialogContent>
        <MudForm>
            <MudTextField T="decimal"
                          @bind-Value="Model.Amount"
                          Error="@isAmountValid"
                          Label="Amount"/>
            <MudDatePicker @bind-Date="Model.DateTime"
                           Error="@isDateValid"
                           Label="Date"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Save">
            Save
        </MudButton>
        <MudButton OnClick="Delete">
            Delete
        </MudButton>
        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>