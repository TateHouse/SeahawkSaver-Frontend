@using SeahawkSaverFrontend.UI.Features.Caching.Services
@using SeahawkSaverFrontend.UI.Features.Debt.Services
@using SeahawkSaverFrontend.UI.Features.Income.Services
@using SeahawkSaverFrontend.UI.Features.Saving.Services
@using SeahawkSaverFrontend.UI.Features.Subscription.Services
@using System.Globalization
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject IDataCache DataCache
@inject IDebtService DebtService
@inject IIncomeService IncomeService
@inject ISavingService SavingService
@inject ISubscriptionService SubscriptionService

<MudContainer>
    <MudTotalCalendar Items="calendarItems"
                      Values="CalculateTotals()"
                      ShowDayTotal="false"
                      ShowWeekTotal="isWeekTotalEnabled"
                      ShowMonthTotal="isMonthTotalEnabled"
                      DateRangeChanged="DateRangeChanged"
                      CellClicked="CellClicked"
                      ItemClicked="ItemClicked"
                      ShowDay="false"
                      ShowWeek="false"
                      ShowWorkWeek="false"
                      ShowMonth="true">
        <ToolbarContent>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="OnDownloadFinancialDataAsync">
                Download Data
            </MudButton>
            <MudSwitch T="bool"
                       @bind-Value="isWeekTotalEnabled"
                       Class="mx-2"
                       Color="Color.Tertiary"
                       UncheckedColor="Color.Secondary">
                Week Totals
            </MudSwitch>
            <MudSwitch T="bool"
                       @bind-Value="isMonthTotalEnabled"
                       Class="mx-2"
                       Color="Color.Tertiary"
                       UncheckedColor="Color.Secondary">
                Month Totals
            </MudSwitch>
        </ToolbarContent>
    </MudTotalCalendar>
    <MudPaper Class="ma-4"
              Style="display: flex; flex-direction: row; gap: 2%">
        <MudChart ChartType="ChartType.Donut"
                  Class="d-flex"
                  Width="300px"
                  Height="300px"
                  InputData="@financialReportData"
                  InputLabels="@financialReportLabels"/>
        <MudChart ChartType="ChartType.Pie"
                  Class="d-flex"
                  Width="300px"
                  Height="300px"
                  InputData="@financialReportData"
                  InputLabels="@financialReportLabels"/>
        <MudCard>
            <MudCardContent>
                <MudText Class="d-flex"
                         Align="Align.Center">
                    Debt: $@financialReportData[0].ToString(CultureInfo.InvariantCulture)
                </MudText>
                <MudText Class="d-flex"
                         Align="Align.Center">
                    Income: $@financialReportData[1].ToString(CultureInfo.InvariantCulture)
                </MudText>
                <MudText Class="d-flex"
                         Align="Align.Center">
                    Saving: $@financialReportData[2].ToString(CultureInfo.InvariantCulture)
                </MudText>
                <MudText Class="d-flex"
                         Align="Align.Center">
                    Subscription: $@financialReportData[3].ToString(CultureInfo.InvariantCulture)
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudPaper>
</MudContainer>