@using SeahawkSaverFrontend.UI.Features.Caching.Services
@using SeahawkSaverFrontend.UI.Features.Debt.Services
@using SeahawkSaverFrontend.UI.Features.Income.Services
@using SeahawkSaverFrontend.UI.Features.Saving.Services
@using SeahawkSaverFrontend.UI.Features.Subscription.Services
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject IDataCache DataCache
@inject IDebtService DebtService
@inject IIncomeService IncomeService
@inject ISavingService SavingService
@inject ISubscriptionService SubscriptionService

<MudContainer>
    <MudCalendar Items="calendarItems"
                 DateRangeChanged="DateRangeChanged"
                 CellClicked="CellClicked"
                 ItemClicked="ItemClicked"
                 ShowDay="false"
                 ShowWeek="false"
                 ShowWorkWeek="false"
                 ShowMonth="true">
        <ToolbarContent>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="DownloadFinancialData">
                Download Data
            </MudButton>
        </ToolbarContent>
    </MudCalendar>
</MudContainer>