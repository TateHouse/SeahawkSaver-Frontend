@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        Create
    </TitleContent>
    <DialogContent>
        <MudTextField T="decimal"
                      Required="true"
                      @bind-Value="model.Amount"
                      Error="@isAmountValid"
                      Label="Amount">
        </MudTextField>
        <MudSelect T="FinancialItemType"
                   Required="true"
                   @bind-Value="model.Type"
                   Label="Type">
            <MudSelectItem Value="FinancialItemType.Debt">Debt</MudSelectItem>
            <MudSelectItem Value="FinancialItemType.Income">Income</MudSelectItem>
            <MudSelectItem Value="FinancialItemType.Saving">Saving</MudSelectItem>
            <MudSelectItem Value="FinancialItemType.Subscription">Subscription</MudSelectItem>
            <MudSelectItem Value="FinancialItemType.Expense">Expense</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit">
            Create
        </MudButton>
        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>